# Copia questo file in .env (backend) e compila i valori. Non committare mai .env.
# Copy to .env and fill in. Never commit real secrets.

# --- Applicazione ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true
API_HOST=127.0.0.1             # solo locale: utente singolo
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
DATABASE_URL=postgresql+psycopg://football:football@localhost:5432/football_ai
# Solo per i test: database dedicato, viene svuotato e ricreato dalla suite.
TEST_DATABASE_URL=postgresql+psycopg://football:football@localhost:5432/football_ai_test

# --- AI (dalla Fase 4) ---
AI_PROVIDER=mock               # mock (offline, nessuna chiamata) | anthropic
AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
AI_DAILY_CALL_LIMIT=100
AI_DAILY_TOKEN_LIMIT=500000
AI_MAX_CALLS_PER_ANALYSIS=5

# --- Fornitori dati (dalla Fase 7) ---
FOOTBALL_DATA_ORG_API_KEY=
